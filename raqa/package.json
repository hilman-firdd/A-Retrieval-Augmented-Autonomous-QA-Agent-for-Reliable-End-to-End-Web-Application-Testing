{
  "name": "raqa",
  "version": "0.1.0",
  "description": "RAQA - Retrieval-Augmented QA agent untuk SIMASIS (pondasi arsitektur)",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@langchain/classic": "1.0.48",
    "@langchain/community": "1.1.29",
    "@langchain/core": "1.2.12",
    "@langchain/ollama": "1.3.0",
    "@langchain/textsplitters": "1.0.1",
    "d3-dsv": "2.0.0",
    "dotenv": "16.4.5",
    "faiss-node": "0.5.1",
    "playwright": "1.56.1",
    "zod": "4.6.5"
  },
  "scripts": {
    "offline-check": "node scripts/offline-check.js",
    "demo": "node scripts/demo.js",
