# Salin menjadi .env bila perlu mengubah default. Semua berjalan lokal; tidak ada API key eksternal.
OLLAMA_BASE_URL=http://127.0.0.1:11434
RAQA_MODEL=qwen3:4b
RAQA_EMBED_MODEL=nomic-embed-text
RAQA_SEED=42
RAQA_NUM_CTX=16384
# 1 = aktifkan mode berpikir Qwen3 (lebih lambat, keluaran bisa kurang stabil antar-run)
RAQA_THINK=0
RAQA_TAU=0.8
RAQA_AUDIT_RATE=0.05
# Staging untuk FR; instance lokal (http://127.0.0.1:8000) untuk FDR/fault seeding
BASE_URL=https://staging.pesantrenpersis27.com
# Folder dokumen QA lokal (.md/.txt/.csv)
RAQA_QA_DOCS=./qa_docs
