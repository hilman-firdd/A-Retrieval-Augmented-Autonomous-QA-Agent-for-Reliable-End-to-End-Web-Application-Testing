# Salin menjadi .env lalu sesuaikan. JANGAN commit file .env.
# URL aplikasi yang diuji. Untuk eksperimen fault seeding, gunakan instance lokal/terpisah,
# misalnya http://localhost:8000, bukan staging yang dipakai pengguna lain.
BASE_URL=https://staging.pesantrenpersis27.com

# Jumlah worker paralel. Biarkan kecil (1-2) agar tidak membebani server staging.
WORKERS=2

# Label eksperimen: baseline | fault-F01 | fault-F02 | ...
RUN_LABEL=baseline

# (Opsional) versi/commit aplikasi yang sedang diuji, dicatat di metadata run.
APP_VERSION=

# (Opsional) akun uji SIMASIS untuk skenario login positif. Kosongkan untuk melewati skenario itu.
# Gunakan akun khusus testing, bukan akun asatidz/santri sungguhan.
SIMASIS_USER=
SIMASIS_PASS=

# Set 1 untuk menjalankan juga Firefox dan WebKit.
ALL_BROWSERS=0
